<Window x:Class="WpfMusicEditor.Forms.UI.Views.TrainingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="음색 모델 만들기 (학습)"
        Width="560" Height="720"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30" />
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3F3F46" />
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="BorderBrush" Value="#55555B" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0E639C" />
            <Setter Property="BorderBrush" Value="#1177BB" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#252526" />
            <Setter Property="Foreground" Value="#DDDDDD" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  1. RVC 설정  -->
                <TextBlock Style="{StaticResource Header}" Text="1. RVC 환경" />
                <TextBlock Foreground="#999999" TextWrapping="Wrap"
                           Text="RVC 폴더(런타임 python 포함)와 python.exe 경로를 지정합니다. 한 번만 설정하면 저장됩니다." />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="RVC 폴더" />
                    <TextBox Grid.Column="1" Text="{Binding RvcRoot}" />
                    <Button Grid.Column="2" Margin="6,0,0,0" Content="찾기…" Command="{Binding BrowseRvcRootCommand}" />
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Python" />
                    <TextBox Grid.Column="1" Text="{Binding PythonPath}" />
                    <Button Grid.Column="2" Margin="6,0,0,0" Content="찾기…" Command="{Binding BrowsePythonCommand}" />
                </Grid>

                <!--  2. 데이터셋  -->
                <TextBlock Style="{StaticResource Header}" Text="2. 데이터셋 (타깃 목소리)" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="오디오 불러오기…" Command="{Binding LoadSourceCommand}" />
                    <TextBlock Margin="10,0,0,0" Text="{Binding SourceFileName}" />
                </StackPanel>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Margin="0,0,6,0" Text="시작(초)" />
                    <TextBox Grid.Column="1" Text="{Binding RegionStartSeconds, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}" />
                    <TextBlock Grid.Column="2" Margin="10,0,6,0" Text="끝(초)" />
                    <TextBox Grid.Column="3" Text="{Binding RegionEndSeconds, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="구간 추가" Command="{Binding AddRegionCommand}" />
                    <Button Margin="6,0,0,0" Content="전체 추가" Command="{Binding AddWholeFileCommand}" />
                    <Button Margin="6,0,0,0" Content="비우기" Command="{Binding ClearDatasetCommand}" />
                    <TextBlock Margin="12,0,0,0" Foreground="#4EC9B0" Text="{Binding DatasetSummary}" />
                </StackPanel>
                <ListBox Height="120" Margin="0,6,0,0" ItemsSource="{Binding DatasetClips}" />

                <!--  3. 파라미터  -->
                <TextBlock Style="{StaticResource Header}" Text="3. 학습 설정" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="모델 이름" />
                    <TextBox Grid.Column="1" Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Margin="10,0,4,0" HorizontalAlignment="Right" Text="epoch" />
                    <TextBox Grid.Column="3" Text="{Binding Epochs, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="4" Margin="10,0,4,0" HorizontalAlignment="Right" Text="batch" />
                    <TextBox Grid.Column="5" Text="{Binding BatchSize, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <TextBlock Margin="0,6,0,0" Foreground="#999999" TextWrapping="Wrap"
                           Text="RTX 3070(8GB) 기준 batch 7 권장. epoch가 클수록 오래 걸립니다(수 분~수 시간). 데이터는 깨끗한 단일 화자 5~30분 권장." />
            </StackPanel>
        </ScrollViewer>

        <!--  진행 + 실행  -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Foreground="#DDDDDD" TextWrapping="Wrap" Text="{Binding Status}" />
            <ProgressBar Height="8" Margin="0,6,0,0" Maximum="100" Minimum="0"
                         Background="#252526" Foreground="#0E639C" BorderThickness="0"
                         Value="{Binding TrainProgress}"
                         Visibility="{Binding IsTraining, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="취소" Command="{Binding CancelTrainingCommand}" />
                <Button Margin="8,0,0,0" Style="{StaticResource Accent}" Content="🎓 학습 시작" Command="{Binding StartTrainingCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
