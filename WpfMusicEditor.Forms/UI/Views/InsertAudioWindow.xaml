<Window x:Class="WpfMusicEditor.Forms.UI.Views.InsertAudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WpfMusicEditor.Forms.UI.Converters"
        xmlns:support="clr-namespace:WpfMusicEditor.Support.UI.Units;assembly=WpfMusicEditor.Support"
        Title="다른 파일에서 구간 삽입"
        Width="700" Height="520"
        MinWidth="560" MinHeight="460"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <conv:EnumToBooleanConverter x:Key="EnumToBool" />
        <conv:GreaterThanZeroConverter x:Key="GreaterThanZero" />

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#252526" />
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="BorderBrush" Value="#3C3C3C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="CaretBrush" Value="#EEEEEE" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ModeButton" TargetType="RadioButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#3C3C3C" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A4A4A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0078D4" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#106EBE" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#3A3A3A" />
                    <Setter Property="Foreground" Value="#888888" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GhostButton" BasedOn="{StaticResource AccentButton}" TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4A4A4A" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#2A2A2A" />
                    <Setter Property="Foreground" Value="#777777" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  파일 열기  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                Command="{Binding OpenFileCommand}"
                Content="파일 열기"
                Style="{StaticResource GhostButton}" />
            <TextBlock
                Grid.Column="1"
                Margin="12,0,0,0"
                Style="{StaticResource Label}"
                Text="{Binding FileName}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <!--  파형  -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,10,0">
                <RadioButton
                    Content="⬚"
                    GroupName="InsertWaveMode"
                    IsChecked="{Binding WaveformMode, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static support:WaveformInteractionMode.Select}}"
                    Style="{StaticResource ModeButton}"
                    ToolTip="선택 모드 · 드래그로 구간 선택" />
                <RadioButton
                    Content="✋"
                    GroupName="InsertWaveMode"
                    IsChecked="{Binding WaveformMode, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static support:WaveformInteractionMode.Pan}}"
                    Style="{StaticResource ModeButton}"
                    ToolTip="이동 모드 · 드래그로 좌우 스크롤 (휠로 확대/축소)" />
            </StackPanel>

            <Border
                Grid.Row="0"
                Grid.Column="1"
                BorderBrush="#3C3C3C"
                BorderThickness="1"
                CornerRadius="3">
                <support:WaveformControl
                    x:Name="PART_Waveform"
                    Background="#252526"
                    Duration="{Binding DurationSeconds}"
                    Mode="{Binding WaveformMode}"
                    Peaks="{Binding Peaks}"
                    PlayPosition="{Binding PlayPositionSeconds, Mode=TwoWay}"
                    ResetView="{Binding WaveformResetView}"
                    SelectionEnd="{Binding EndSeconds, Mode=TwoWay}"
                    SelectionStart="{Binding StartSeconds, Mode=TwoWay}" />
            </Border>

            <Slider
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,8,0,0"
                IsEnabled="{Binding MaxViewStart, ElementName=PART_Waveform, Converter={StaticResource GreaterThanZero}}"
                IsMoveToPointEnabled="True"
                LargeChange="1"
                Maximum="{Binding MaxViewStart, ElementName=PART_Waveform}"
                Minimum="0"
                SmallChange="0.1"
                Value="{Binding ViewStart, ElementName=PART_Waveform, Mode=TwoWay}" />
        </Grid>

        <!--  구간 선택  -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Margin="0,0,8,0"
                Style="{StaticResource Label}"
                Text="시작(초)" />
            <TextBox
                Grid.Column="1"
                Style="{StaticResource DarkTextBox}"
                Text="{Binding StartSeconds, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" />
            <TextBlock
                Grid.Column="3"
                Margin="0,0,8,0"
                Style="{StaticResource Label}"
                Text="끝(초)" />
            <TextBox
                Grid.Column="4"
                Style="{StaticResource DarkTextBox}"
                Text="{Binding EndSeconds, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" />
        </Grid>

        <!--  재생 / 확정  -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                Width="96"
                Command="{Binding PlayPauseCommand}"
                Content="{Binding PlayPauseLabel}"
                Style="{StaticResource GhostButton}" />
            <Button
                Grid.Column="1"
                Margin="8,0,0,0"
                Command="{Binding StopCommand}"
                Content="■ 정지"
                Style="{StaticResource GhostButton}" />
            <Button
                Grid.Column="3"
                Margin="0,0,8,0"
                Click="OnCancel"
                Content="취소"
                Style="{StaticResource GhostButton}" />
            <Button
                Grid.Column="4"
                Click="OnConfirm"
                Content="➜ 이 구간 삽입"
                IsEnabled="{Binding CanConfirm}"
                Style="{StaticResource AccentButton}" />
        </Grid>

        <!--  상태  -->
        <TextBlock
            Grid.Row="4"
            Margin="0,12,0,0"
            Style="{StaticResource Label}"
            Text="{Binding Status}"
            TextWrapping="Wrap" />
    </Grid>
</Window>
