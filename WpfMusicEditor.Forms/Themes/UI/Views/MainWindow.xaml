<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:WpfMusicEditor.Forms.UI.Converters"
    xmlns:support="clr-namespace:WpfMusicEditor.Support.UI.Units;assembly=WpfMusicEditor.Support"
    xmlns:views="clr-namespace:WpfMusicEditor.Forms.UI.Views">

    <conv:EnumToBooleanConverter x:Key="EnumToBool" />
    <conv:GreaterThanZeroConverter x:Key="GreaterThanZero" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!--  파형 모드 토글 (선택 / 이동)  -->
    <Style x:Key="ModeButton" TargetType="RadioButton">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Foreground" Value="#CCCCCC" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="#3C3C3C" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#4A4A4A" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0078D4" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  공통 입력 스타일 (다크 테마)  -->
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#AAAAAA" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DarkTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#252526" />
        <Setter Property="Foreground" Value="#EEEEEE" />
        <Setter Property="BorderBrush" Value="#3C3C3C" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="CaretBrush" Value="#EEEEEE" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--  전사 결과 목록 (다크 테마, 줄 선택/순서변경)  -->
    <Style x:Key="DarkListBox" TargetType="ListBox">
        <Setter Property="Background" Value="#252526" />
        <Setter Property="BorderBrush" Value="#3C3C3C" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#EEEEEE" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style x:Key="DarkListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="#DDDDDD" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2D2D30" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0078D4" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="#0078D4" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#106EBE" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#3A3A3A" />
                <Setter Property="Foreground" Value="#888888" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GhostButton" BasedOn="{StaticResource AccentButton}" TargetType="Button">
        <Setter Property="Background" Value="#3C3C3C" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#4A4A4A" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#2A2A2A" />
                <Setter Property="Foreground" Value="#777777" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CutButton" BasedOn="{StaticResource AccentButton}" TargetType="Button">
        <Setter Property="Background" Value="#C04545" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#D45656" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#3A3A3A" />
                <Setter Property="Foreground" Value="#888888" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource {x:Type support:WpfMusicEditorWindow}}" TargetType="{x:Type views:MainWindow}">
        <Setter Property="Title" Value="WpfMusicEditor" />
        <Setter Property="Width" Value="640" />
        <Setter Property="Height" Value="680" />
        <Setter Property="MinWidth" Value="520" />
        <Setter Property="MinHeight" Value="560" />
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:MainWindow}">
                    <Border
                        Background="#1E1E1E"
                        BorderBrush="#3C3C3C"
                        BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  Title Bar  -->
                            <Grid Grid.Row="0" Background="#2D2D2D">
                                <Menu
                                    Margin="4,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="Transparent">
                                    <MenuItem
                                        Padding="8,2"
                                        FontSize="16"
                                        Foreground="#CCCCCC"
                                        Header="☰">
                                        <MenuItem Command="{Binding OpenSettingsCommand}" Header="⚙ 설정" />
                                    </MenuItem>
                                </Menu>
                                <TextBlock
                                    Margin="44,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="#CCCCCC"
                                    Text="{TemplateBinding Title}" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <support:MinimizeButton x:Name="PART_MinimizeButton" />
                                    <support:MaximizeButton x:Name="PART_MaximizeButton" />
                                    <support:CloseButton x:Name="PART_CloseButton" />
                                </StackPanel>
                            </Grid>

                            <!--  Editor  -->
                            <Grid Grid.Row="1" Margin="20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--  상단: GPU 경고 배너 + 파일 열기  -->
                                <StackPanel Grid.Row="0">
                                    <!--  GPU(CUDA) 없을 때만 표시  -->
                                    <Border
                                        Margin="0,0,0,12"
                                        Padding="10,6"
                                        Background="#3A2F1A"
                                        BorderBrush="#6B5418"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Visibility="{Binding ShowGpuWarning, Converter={StaticResource BoolToVis}}">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="#E8C46A"
                                            Text="⚠ GPU(NVIDIA/CUDA)가 없어 음성 인식(STT)이 CPU로 동작하며 매우 느릴 수 있습니다."
                                            TextWrapping="Wrap" />
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Grid.Column="0"
                                            Command="{Binding OpenFileCommand}"
                                            Content="파일 열기"
                                            Style="{StaticResource GhostButton}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            Style="{StaticResource Label}"
                                            Text="{Binding FileName}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </StackPanel>

                                <!--  파형  -->
                                <Grid Grid.Row="1" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--  모드 툴바: 선택 / 이동  -->
                                    <StackPanel
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,10,0">
                                        <RadioButton
                                            Content="⬚"
                                            GroupName="WaveMode"
                                            IsChecked="{Binding WaveformMode, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static support:WaveformInteractionMode.Select}}"
                                            Style="{StaticResource ModeButton}"
                                            ToolTip="선택 모드 · 드래그로 구간 선택" />
                                        <RadioButton
                                            Content="✋"
                                            GroupName="WaveMode"
                                            IsChecked="{Binding WaveformMode, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static support:WaveformInteractionMode.Pan}}"
                                            Style="{StaticResource ModeButton}"
                                            ToolTip="이동 모드 · 드래그로 좌우 스크롤 (휠로 확대/축소)" />
                                    </StackPanel>

                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        BorderBrush="#3C3C3C"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <support:WaveformControl
                                            x:Name="PART_Waveform"
                                            Background="#252526"
                                            Duration="{Binding DurationSeconds}"
                                            Mode="{Binding WaveformMode}"
                                            Peaks="{Binding Peaks}"
                                            PlayPosition="{Binding PlayPositionSeconds, Mode=TwoWay}"
                                            ResetView="{Binding WaveformResetView}"
                                            SelectionEnd="{Binding EndSeconds, Mode=TwoWay}"
                                            SelectionStart="{Binding StartSeconds, Mode=TwoWay}" />
                                    </Border>

                                    <!--  가로 스크롤 슬라이더 (확대 시 좌우 이동)  -->
                                    <Slider
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,8,0,0"
                                        IsEnabled="{Binding MaxViewStart, ElementName=PART_Waveform, Converter={StaticResource GreaterThanZero}}"
                                        IsMoveToPointEnabled="True"
                                        LargeChange="1"
                                        Maximum="{Binding MaxViewStart, ElementName=PART_Waveform}"
                                        Minimum="0"
                                        SmallChange="0.1"
                                        Value="{Binding ViewStart, ElementName=PART_Waveform, Mode=TwoWay}" />
                                </Grid>

                                <!--  구간 선택  -->
                                <Grid Grid.Row="2" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource Label}"
                                        Text="시작(초)" />
                                    <TextBox
                                        Grid.Column="1"
                                        Style="{StaticResource DarkTextBox}"
                                        Text="{Binding StartSeconds, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource Label}"
                                        Text="끝(초)" />
                                    <TextBox
                                        Grid.Column="4"
                                        Style="{StaticResource DarkTextBox}"
                                        Text="{Binding EndSeconds, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" />
                                </Grid>

                                <!--  재생 / 편집 컨트롤  -->
                                <Grid Grid.Row="3" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Grid.Column="0"
                                        Width="96"
                                        Command="{Binding PlayPauseCommand}"
                                        Content="{Binding PlayPauseLabel}"
                                        Style="{StaticResource GhostButton}" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Command="{Binding StopCommand}"
                                        Content="■ 정지"
                                        Style="{StaticResource GhostButton}" />
                                    <Button
                                        Grid.Column="3"
                                        Margin="0,0,8,0"
                                        Command="{Binding UndoCommand}"
                                        Content="↶ 실행취소"
                                        Style="{StaticResource GhostButton}" />
                                    <Button
                                        Grid.Column="4"
                                        Command="{Binding CutCommand}"
                                        Content="✂ 구간 잘라내기"
                                        Style="{StaticResource CutButton}" />
                                </Grid>

                                <!--  구간 볼륨 조절 (게인)  -->
                                <Grid Grid.Row="4" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource Label}"
                                        Text="게인(dB)" />
                                    <TextBox
                                        Grid.Column="1"
                                        Style="{StaticResource DarkTextBox}"
                                        Text="{Binding GainDb, UpdateSourceTrigger=PropertyChanged, StringFormat=0.#}"
                                        ToolTip="양수는 볼륨을 키우고 음수는 줄입니다. +6dB ≈ 두 배, -6dB ≈ 절반" />
                                    <Button
                                        Grid.Column="3"
                                        Command="{Binding ApplyGainCommand}"
                                        Content="🔊 구간 볼륨 적용"
                                        Style="{StaticResource AccentButton}" />
                                </Grid>

                                <!--  음색 변환 (RVC, .onnx 모델)  -->
                                <Grid Grid.Row="5" Margin="0,16,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Button
                                                Command="{Binding PickVoiceModelCommand}"
                                                Content="📂 모델…"
                                                Style="{StaticResource GhostButton}"
                                                ToolTip="타깃 목소리로 학습·export한 RVC generator(.onnx)를 고릅니다 (docs/voice-conversion.md 참고)" />
                                            <Button
                                                Margin="6,0,0,0"
                                                Command="{Binding ImportPthCommand}"
                                                Content="📥 .pth 변환"
                                                Style="{StaticResource GhostButton}"
                                                ToolTip="받은 RVC .pth 목소리 모델을 .onnx로 변환해 바로 사용합니다(RVC 필요)" />
                                            <Button
                                                Margin="6,0,0,0"
                                                Command="{Binding OpenTrainingCommand}"
                                                Content="🎓 모델 만들기"
                                                Style="{StaticResource GhostButton}"
                                                ToolTip="내 녹음 파일로 새 음색 모델을 학습합니다(RVC 필요)" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="8,0,8,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Label}"
                                            Text="{Binding VoiceModelName}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding VoiceModelPath}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource Label}"
                                            Text="반음" />
                                        <TextBox
                                            Grid.Column="3"
                                            Style="{StaticResource DarkTextBox}"
                                            Text="{Binding SemitoneShift, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="피치 시프트(반음). 0이면 원래 음높이 유지. 남→여 변환 시 +12 등으로 올립니다" />
                                        <Button
                                            Grid.Column="4"
                                            Margin="8,0,0,0"
                                            Command="{Binding ConvertVoiceCommand}"
                                            Content="🎤 음색 변환"
                                            Style="{StaticResource AccentButton}"
                                            ToolTip="드래그한 구간의 음색을 선택한 모델 목소리로 바꿉니다. 발음·타이밍은 유지됩니다 (Ctrl+Z로 실행 취소)" />
                                    </Grid>
                                    <ProgressBar
                                        Grid.Row="1"
                                        Height="6"
                                        Margin="0,8,0,0"
                                        Background="#252526"
                                        BorderThickness="0"
                                        Foreground="#0078D4"
                                        Maximum="100"
                                        Minimum="0"
                                        Value="{Binding ConvertVoiceProgress}"
                                        Visibility="{Binding IsConvertingVoice, Converter={StaticResource BoolToVis}}" />
                                </Grid>

                                <!--  음성 인식: 선택 구간 전사  -->
                                <Grid Grid.Row="6" Margin="0,16,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <Button
                                            Command="{Binding TranscribeCommand}"
                                            Content="🎙 선택 구간 전사"
                                            Style="{StaticResource GhostButton}"
                                            ToolTip="드래그한 구간의 음성을 한국어 텍스트로 받아씁니다. 결과는 아래에 계속 누적됩니다 (최초 1회 모델 다운로드)" />
                                        <Button
                                            Margin="8,0,0,0"
                                            Command="{Binding ClearTranscriptCommand}"
                                            Content="🗑 지우기"
                                            Style="{StaticResource GhostButton}"
                                            ToolTip="누적된 전사 결과를 모두 지웁니다" />
                                        <Button
                                            Width="36"
                                            Margin="16,0,0,0"
                                            Padding="0"
                                            Command="{Binding MoveLinesUpCommand}"
                                            CommandParameter="{Binding SelectedItems, ElementName=PART_TranscriptList}"
                                            Content="↑"
                                            Style="{StaticResource GhostButton}"
                                            ToolTip="선택한 줄을 위로 이동" />
                                        <Button
                                            Width="36"
                                            Margin="8,0,0,0"
                                            Padding="0"
                                            Command="{Binding MoveLinesDownCommand}"
                                            CommandParameter="{Binding SelectedItems, ElementName=PART_TranscriptList}"
                                            Content="↓"
                                            Style="{StaticResource GhostButton}"
                                            ToolTip="선택한 줄을 아래로 이동" />
                                    </StackPanel>
                                    <ProgressBar
                                        Grid.Row="1"
                                        Height="6"
                                        Margin="0,8,0,0"
                                        Background="#252526"
                                        BorderThickness="0"
                                        Foreground="#0078D4"
                                        Maximum="100"
                                        Minimum="0"
                                        Value="{Binding TranscribeProgress}"
                                        Visibility="{Binding IsTranscribing, Converter={StaticResource BoolToVis}}">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar">
                                                <Style.Triggers>
                                                    <!--  세그먼트가 나오기 전(0%)에는 진행 중임을 알리도록 불확정 애니메이션  -->
                                                    <DataTrigger Binding="{Binding TranscribeProgress}" Value="0">
                                                        <Setter Property="IsIndeterminate" Value="True" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                    <ListBox
                                        x:Name="PART_TranscriptList"
                                        Grid.Row="2"
                                        Height="96"
                                        Margin="0,8,0,0"
                                        DisplayMemberPath="Text"
                                        ItemContainerStyle="{StaticResource DarkListBoxItem}"
                                        ItemsSource="{Binding TranscriptLines}"
                                        SelectionMode="Extended"
                                        Style="{StaticResource DarkListBox}"
                                        ToolTip="드래그(또는 Shift/Ctrl 클릭)로 여러 줄 선택 → ↑↓ 버튼으로 순서 변경" />
                                </Grid>

                                <!--  출력 포맷  -->
                                <Grid Grid.Row="7" Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource Label}"
                                        Text="출력 포맷" />
                                    <ComboBox
                                        Grid.Column="1"
                                        ItemsSource="{Binding Formats}"
                                        SelectedItem="{Binding SelectedFormat}" />
                                </Grid>

                                <!--  상태  -->
                                <TextBlock
                                    Grid.Row="8"
                                    Margin="0,12,0,0"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource Label}"
                                    Text="{Binding Status}"
                                    TextWrapping="Wrap" />

                                <!--  내보내기  -->
                                <Button
                                    Grid.Row="9"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Right"
                                    Command="{Binding ExportCommand}"
                                    Content="내보내기"
                                    Style="{StaticResource AccentButton}" />
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
