<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:WpfMusicEditor.Forms.UI.Converters"
    xmlns:support="clr-namespace:WpfMusicEditor.Support.UI.Units;assembly=WpfMusicEditor.Support"
    xmlns:views="clr-namespace:WpfMusicEditor.Forms.UI.Views">

    <conv:EnumToBooleanConverter x:Key="EnumToBool" />
    <conv:GreaterThanZeroConverter x:Key="GreaterThanZero" />

    <!--  파형 모드 토글 (선택 / 이동)  -->
    <Style x:Key="ModeButton" TargetType="RadioButton">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Foreground" Value="#CCCCCC" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="#3C3C3C" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#4A4A4A" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0078D4" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  공통 입력 스타일 (다크 테마)  -->
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#AAAAAA" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DarkTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#252526" />
        <Setter Property="Foreground" Value="#EEEEEE" />
        <Setter Property="BorderBrush" Value="#3C3C3C" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="CaretBrush" Value="#EEEEEE" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="#0078D4" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#106EBE" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#3A3A3A" />
                <Setter Property="Foreground" Value="#888888" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GhostButton" BasedOn="{StaticResource AccentButton}" TargetType="Button">
        <Setter Property="Background" Value="#3C3C3C" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#4A4A4A" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#2A2A2A" />
                <Setter Property="Foreground" Value="#777777" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CutButton" BasedOn="{StaticResource AccentButton}" TargetType="Button">
        <Setter Property="Background" Value="#C04545" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#D45656" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#3A3A3A" />
                <Setter Property="Foreground" Value="#888888" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource {x:Type support:WpfMusicEditorWindow}}" TargetType="{x:Type views:MainWindow}">
        <Setter Property="Title" Value="WpfMusicEditor" />
        <Setter Property="Width" Value="640" />
        <Setter Property="Height" Value="680" />
        <Setter Property="MinWidth" Value="520" />
        <Setter Property="MinHeight" Value="560" />
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:MainWindow}">
                    <Border
                        Background="#1E1E1E"
                        BorderBrush="#3C3C3C"
                        BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  Title Bar  -->
                            <Grid Grid.Row="0" Background="#2D2D2D">
                                <TextBlock
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="#CCCCCC"
                                    Text="{TemplateBinding Title}" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <support:MinimizeButton x:Name="PART_MinimizeButton" />
                                    <support:MaximizeButton x:Name="PART_MaximizeButton" />
                                    <support:CloseButton x:Name="PART_CloseButton" />
                                </StackPanel>
                            </Grid>

                            <!--  Editor  -->
                            <Grid Grid.Row="1" Margin="20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--  파일 열기  -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Grid.Column="0"
                                        Command="{Binding OpenFileCommand}"
                                        Content="파일 열기"
                                        Style="{StaticResource GhostButton}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Style="{StaticResource Label}"
                                        Text="{Binding FileName}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <!--  파형  -->
                                <Grid Grid.Row="1" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--  모드 툴바: 선택 / 이동  -->
                                    <StackPanel
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,10,0">
                                        <RadioButton
                                            Content="⬚"
                                            GroupName="WaveMode"
                                            IsChecked="{Binding WaveformMode, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static support:WaveformInteractionMode.Select}}"
                                            Style="{StaticResource ModeButton}"
                                            ToolTip="선택 모드 · 드래그로 구간 선택" />
                                        <RadioButton
                                            Content="✋"
                                            GroupName="WaveMode"
                                            IsChecked="{Binding WaveformMode, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static support:WaveformInteractionMode.Pan}}"
                                            Style="{StaticResource ModeButton}"
                                            ToolTip="이동 모드 · 드래그로 좌우 스크롤 (휠로 확대/축소)" />
                                    </StackPanel>

                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        BorderBrush="#3C3C3C"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <support:WaveformControl
                                            x:Name="PART_Waveform"
                                            Background="#252526"
                                            Duration="{Binding DurationSeconds}"
                                            Mode="{Binding WaveformMode}"
                                            Peaks="{Binding Peaks}"
                                            PlayPosition="{Binding PlayPositionSeconds, Mode=TwoWay}"
                                            ResetView="{Binding WaveformResetView}"
                                            SelectionEnd="{Binding EndSeconds, Mode=TwoWay}"
                                            SelectionStart="{Binding StartSeconds, Mode=TwoWay}" />
                                    </Border>

                                    <!--  가로 스크롤 슬라이더 (확대 시 좌우 이동)  -->
                                    <Slider
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,8,0,0"
                                        IsEnabled="{Binding MaxViewStart, ElementName=PART_Waveform, Converter={StaticResource GreaterThanZero}}"
                                        IsMoveToPointEnabled="True"
                                        LargeChange="1"
                                        Maximum="{Binding MaxViewStart, ElementName=PART_Waveform}"
                                        Minimum="0"
                                        SmallChange="0.1"
                                        Value="{Binding ViewStart, ElementName=PART_Waveform, Mode=TwoWay}" />
                                </Grid>

                                <!--  구간 선택  -->
                                <Grid Grid.Row="2" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource Label}"
                                        Text="시작(초)" />
                                    <TextBox
                                        Grid.Column="1"
                                        Style="{StaticResource DarkTextBox}"
                                        Text="{Binding StartSeconds, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource Label}"
                                        Text="끝(초)" />
                                    <TextBox
                                        Grid.Column="4"
                                        Style="{StaticResource DarkTextBox}"
                                        Text="{Binding EndSeconds, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" />
                                </Grid>

                                <!--  재생 / 편집 컨트롤  -->
                                <Grid Grid.Row="3" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Grid.Column="0"
                                        Width="96"
                                        Command="{Binding PlayPauseCommand}"
                                        Content="{Binding PlayPauseLabel}"
                                        Style="{StaticResource GhostButton}" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Command="{Binding StopCommand}"
                                        Content="■ 정지"
                                        Style="{StaticResource GhostButton}" />
                                    <Button
                                        Grid.Column="3"
                                        Margin="0,0,8,0"
                                        Command="{Binding UndoCommand}"
                                        Content="↶ 실행취소"
                                        Style="{StaticResource GhostButton}" />
                                    <Button
                                        Grid.Column="4"
                                        Command="{Binding CutCommand}"
                                        Content="✂ 구간 잘라내기"
                                        Style="{StaticResource CutButton}" />
                                </Grid>

                                <!--  구간 볼륨 조절 (게인)  -->
                                <Grid Grid.Row="4" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource Label}"
                                        Text="게인(dB)" />
                                    <TextBox
                                        Grid.Column="1"
                                        Style="{StaticResource DarkTextBox}"
                                        Text="{Binding GainDb, UpdateSourceTrigger=PropertyChanged, StringFormat=0.#}"
                                        ToolTip="양수는 볼륨을 키우고 음수는 줄입니다. +6dB ≈ 두 배, -6dB ≈ 절반" />
                                    <Button
                                        Grid.Column="3"
                                        Command="{Binding ApplyGainCommand}"
                                        Content="🔊 구간 볼륨 적용"
                                        Style="{StaticResource AccentButton}" />
                                </Grid>

                                <!--  음성 인식: 선택 구간 전사  -->
                                <Grid Grid.Row="5" Margin="0,16,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button
                                        Grid.Row="0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding TranscribeCommand}"
                                        Content="🎙 선택 구간 전사"
                                        Style="{StaticResource GhostButton}"
                                        ToolTip="드래그한 구간의 음성을 한국어 텍스트로 받아씁니다 (최초 1회 모델 다운로드)" />
                                    <TextBox
                                        Grid.Row="1"
                                        Height="84"
                                        Margin="0,8,0,0"
                                        VerticalContentAlignment="Top"
                                        IsReadOnly="True"
                                        Style="{StaticResource DarkTextBox}"
                                        Text="{Binding Transcript, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto" />
                                </Grid>

                                <!--  출력 포맷  -->
                                <Grid Grid.Row="6" Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource Label}"
                                        Text="출력 포맷" />
                                    <ComboBox
                                        Grid.Column="1"
                                        ItemsSource="{Binding Formats}"
                                        SelectedItem="{Binding SelectedFormat}" />
                                </Grid>

                                <!--  상태  -->
                                <TextBlock
                                    Grid.Row="7"
                                    Margin="0,12,0,0"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource Label}"
                                    Text="{Binding Status}"
                                    TextWrapping="Wrap" />

                                <!--  내보내기  -->
                                <Button
                                    Grid.Row="8"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Right"
                                    Command="{Binding ExportCommand}"
                                    Content="내보내기"
                                    Style="{StaticResource AccentButton}" />
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
